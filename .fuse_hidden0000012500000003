<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Finito — the Chenile state machine for Java</title>
<meta name="description" content="Finito is a lightweight, XML-driven finite state machine for Java. Define workflows declaratively, generate a full service with jgen, and get Mermaid and PlantUML state diagrams automatically. Part of the Chenile group — usable standalone.">
<meta name="theme-color" content="#0b1120">
<meta property="og:title" content="Finito — the Chenile state machine">
<meta property="og:description" content="XML-driven finite state machine for Java, with automatic Mermaid + PlantUML diagrams and a code generator. Part of Chenile — works standalone.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;850&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --teal:#14b8a6; --teal-deep:#0d9488; --teal-light:#2dd4bf;
  --amber:#f89038; --amber-deep:#e0801e;      /* Chenile group accent */
  --ink:#0b1120; --ink-2:#131b2e; --ink-3:#1c273f;
  --slate:#475569; --muted:#8a94a6; --line:#e6eaf0; --paper:#fff;
  --soft:#f5f8fa; --soft-2:#e9fbf7; --code-bg:#0f1729;
  --grad:linear-gradient(135deg,#0d9488 0%,#14b8a6 50%,#2dd4bf 100%);
  --grad-amber:linear-gradient(135deg,#e0801e,#f89038);
  --shadow-sm:0 1px 2px rgba(11,17,32,.06),0 2px 8px rgba(11,17,32,.05);
  --shadow-md:0 10px 30px rgba(11,17,32,.10);
  --shadow-lg:0 24px 60px rgba(13,148,136,.20);
  --radius:16px; --maxw:1120px;
  --font:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--font);color:var(--ink);background:var(--paper);line-height:1.65;font-size:17px;-webkit-font-smoothing:antialiased}
a{color:var(--teal-deep);text-decoration:none}a:hover{text-decoration:underline}
img{max-width:100%}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.narrow{max-width:860px;margin:0 auto;padding:0 24px}
h1,h2,h3,h4{line-height:1.15;letter-spacing:-.02em;font-weight:800;margin-top:0}
h1{font-size:clamp(2.2rem,5.4vw,3.6rem)}
h2{font-size:clamp(1.6rem,3.4vw,2.3rem)}
h3{font-size:1.22rem;font-weight:750}
p{margin:0 0 1rem}
.eyebrow{display:inline-block;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-deep);background:var(--soft-2);padding:6px 12px;border-radius:999px;margin-bottom:16px}
.lead{font-size:1.2rem;color:var(--slate)}
code{font-family:var(--mono);background:var(--soft-2);color:var(--teal-deep);padding:2px 6px;border-radius:6px;font-size:.86em}
pre{background:var(--code-bg);color:#e6ecf7;padding:20px 22px;border-radius:14px;overflow-x:auto;font-size:.86rem;line-height:1.6;margin:0}
pre code{background:none;color:inherit;padding:0}
.tok-tag{color:#7dd3fc}.tok-attr{color:#fcd34d}.tok-str{color:#86efac}.tok-cm{color:#64748b}.tok-kw{color:#f9a8d4}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:650;font-size:1rem;padding:13px 24px;border-radius:999px;border:1px solid transparent;cursor:pointer;transition:transform .15s,box-shadow .2s}
.btn:hover{text-decoration:none;transform:translateY(-2px)}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 10px 24px rgba(13,148,136,.35)}
.btn-ghost{background:#fff;color:var(--ink);border-color:var(--line);box-shadow:var(--shadow-sm)}
.btn-light{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.3)}
.btn-light:hover{background:rgba(255,255,255,.2)}

/* nav */
.nav{position:sticky;top:0;z-index:50;background:rgba(11,17,32,.85);backdrop-filter:saturate(160%) blur(14px);border-bottom:1px solid rgba(255,255,255,.08)}
.nav-inner{display:flex;align-items:center;gap:22px;height:64px}
.brand{display:flex;align-items:center;gap:11px;color:#fff;font-weight:800;font-size:1.2rem;letter-spacing:-.02em}
.brand:hover{text-decoration:none}
.logo-mark{width:30px;height:30px;flex:none}
.brand .grp{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#0b1120;background:var(--amber);padding:3px 7px;border-radius:999px;margin-left:2px}
.nav-links{display:flex;align-items:center;gap:4px;margin-left:auto}
.nav-links a{color:#c7d0de;font-weight:600;font-size:.93rem;padding:8px 12px;border-radius:8px}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.08);text-decoration:none}
.nav-cta{background:var(--grad);color:#fff !important;border-radius:999px !important;padding:9px 18px !important}
@media(max-width:820px){.nav-links a:not(.nav-cta){display:none}}

/* hero */
.hero{position:relative;background:var(--ink);color:#fff;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:
  radial-gradient(60% 80% at 12% 0%,rgba(20,184,166,.35),transparent 60%),
  radial-gradient(55% 70% at 92% 15%,rgba(45,212,191,.28),transparent 60%),
  radial-gradient(50% 60% at 78% 100%,rgba(248,144,56,.16),transparent 60%)}
.hero-inner{position:relative;padding:84px 24px 76px;text-align:center}
.hero h1{color:#fff;max-width:16ch;margin:0 auto 18px}
.hero h1 .g{background:linear-gradient(90deg,#5eead4,#99f6e4);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .lead{color:#c7d0de;max-width:60ch;margin:0 auto 26px;font-size:1.25rem}
.hero .eyebrow{background:rgba(255,255,255,.1);color:#5eead4}
.badges{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:0 0 28px}
.badge{font-size:.8rem;font-weight:650;color:#c7d0de;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);padding:7px 14px;border-radius:999px}
.badge b{color:#fff}
.badge.amber{border-color:rgba(248,144,56,.5);color:#ffd9ad}
.hero-actions{display:flex;gap:13px;justify-content:center;flex-wrap:wrap}
.hero-note{margin-top:18px;font-family:var(--mono);font-size:.85rem;color:#8a94a6}

/* sections */
section{padding:82px 0}
.section-head{text-align:center;max-width:760px;margin:0 auto 48px}
.section-head .lead{margin-top:10px}
.bg-soft{background:var(--soft)}
.bg-ink{background:var(--ink);color:#fff}
.bg-ink h2{color:#fff}.bg-ink .lead{color:#c7d0de}
.bg-ink .eyebrow{background:rgba(255,255,255,.1);color:#5eead4}

/* feature grid */
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm);transition:transform .2s,box-shadow .2s}
.card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
.card .ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:1.4rem;background:var(--soft-2)}
.card h3{margin:14px 0 8px}.card p{color:var(--slate);margin:0;font-size:.97rem}

/* ===== HTML STATE-DIAGRAM SCHEMATIC ===== */
.fsm{--gap:20px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:34px 26px;box-shadow:var(--shadow-md);overflow-x:auto}
.fsm-legend{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:26px;font-size:.82rem;color:var(--muted)}
.fsm-legend span{display:inline-flex;align-items:center;gap:7px}
.dot{width:13px;height:13px;border-radius:4px;display:inline-block}
.dot.start{border-radius:50%;background:var(--ink)}
.dot.manual{background:#fff;border:2px solid var(--teal)}
.dot.auto{background:#dcfce7;border:2px solid #22c55e}
.dot.term{background:var(--teal);border-radius:50%}
.track{display:flex;align-items:center;gap:6px;min-width:max-content}
.node{position:relative;flex:none;min-width:120px;text-align:center;padding:16px 18px;border-radius:14px;font-weight:750;font-size:.92rem;background:#fff;border:2px solid var(--teal);color:var(--ink);box-shadow:var(--shadow-sm)}
.node .k{display:block;font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
.node.start{min-width:0;width:26px;height:26px;padding:0;border-radius:50%;background:var(--ink);border:none}
.node.term{background:var(--grad);border:none;color:#fff}
.node.auto{border-color:#22c55e;background:#f0fdf4}
.node.auto .k{color:#16a34a}
.arrow{flex:none;display:flex;flex-direction:column;align-items:center;min-width:64px;color:var(--muted)}
.arrow .lbl{font-family:var(--mono);font-size:.68rem;color:var(--teal-deep);background:var(--soft-2);padding:1px 7px;border-radius:6px;margin-bottom:3px;white-space:nowrap}
.arrow .line{width:100%;height:2px;background:var(--teal);position:relative}
.arrow .line::after{content:"";position:absolute;right:-1px;top:-4px;border-left:8px solid var(--teal);border-top:5px solid transparent;border-bottom:5px solid transparent}
.branch{display:flex;flex-direction:column;gap:14px;flex:none}
.branch-row{display:flex;align-items:center;gap:6px}
.arrow.up .lbl,.arrow.down .lbl{background:#fef3c7;color:#b45309}
.arrow.up .line,.arrow.down .line{background:#f59e0b}
.arrow.up .line::after,.arrow.down .line::after{border-left-color:#f59e0b}
.fsm-cap{text-align:center;color:var(--muted);font-size:.85rem;margin-top:22px}

/* pipeline schematic (HTML) */
.pipe{display:flex;align-items:stretch;gap:0;flex-wrap:wrap;justify-content:center}
.pipe .step{flex:1 1 150px;min-width:150px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;text-align:center;box-shadow:var(--shadow-sm);position:relative}
.pipe .step .ic{font-size:1.6rem}
.pipe .step h4{margin:8px 0 4px;font-size:1rem}
.pipe .step p{margin:0;font-size:.82rem;color:var(--muted)}
.pipe .conn{display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:var(--teal);flex:0 0 40px}
.pipe .step.out{background:var(--ink);color:#fff;border:none}
.pipe .step.out p{color:#c7d0de}
.pipe .step.mermaid-out{border-color:#22c55e}
.pipe .fork{display:flex;flex-direction:column;gap:12px;flex:1 1 200px}
@media(max-width:760px){.pipe{flex-direction:column}.pipe .conn{transform:rotate(90deg);flex-basis:30px}}

/* code split */
.codewrap{border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow-md)}
.codewrap .bar{background:var(--ink-2);color:#c7d0de;font-family:var(--mono);font-size:.78rem;padding:10px 16px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:8px}
.codewrap .bar .dotr{width:11px;height:11px;border-radius:50%;background:#334155}
.codewrap pre{border-radius:0}
.mermaid-live{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;display:flex;justify-content:center;box-shadow:var(--shadow-sm);min-height:120px}

/* callout */
.callout{border-radius:14px;padding:20px 24px;border:1px solid var(--line);background:var(--soft)}
.callout.key{background:var(--soft-2);border-color:#a7f3d0}
.callout .t{font-weight:750;margin-bottom:4px}
.callout.amber{background:#fff7ed;border-color:#fed7aa}

/* CLI */
.cli-opts{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:8px}
.cli-opt{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;box-shadow:var(--shadow-sm)}
.cli-opt code{background:var(--ink);color:#5eead4;font-size:.86rem;padding:3px 8px;border-radius:6px}
.cli-opt p{margin:10px 0 0;font-size:.9rem;color:var(--slate)}

/* two-home split */
.homes{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.home{border-radius:18px;padding:30px;border:1px solid var(--line);background:#fff;box-shadow:var(--shadow-sm)}
.home.grp{background:linear-gradient(180deg,#fff7ed,#fff);border-color:#fed7aa}
.home.solo{background:linear-gradient(180deg,#e9fbf7,#fff);border-color:#a7f3d0}
.home h3{display:flex;align-items:center;gap:10px}
.home ul{margin:12px 0 0;padding-left:20px;color:var(--slate)}.home li{margin-bottom:7px}

/* cta + footer */
.cta-box{background:var(--grad);border-radius:26px;padding:60px 32px;color:#fff;text-align:center;box-shadow:var(--shadow-lg)}
.cta-box h2{color:#fff}.cta-box p{color:rgba(255,255,255,.92);max-width:52ch;margin:10px auto 24px;font-size:1.12rem}
.footer{background:var(--ink);color:#8a94a6;padding:50px 0 30px}
.footer a{color:#c7d0de}
.footer-grid{display:flex;justify-content:space-between;gap:28px;flex-wrap:wrap;align-items:flex-start}
.footer .brand{margin-bottom:8px}
.footer-links{display:flex;gap:40px;flex-wrap:wrap}
.footer-links h4{color:#fff;font-size:.9rem;margin:0 0 12px}
.footer-links ul{list-style:none;margin:0;padding:0}.footer-links li{margin-bottom:8px;font-size:.92rem}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:36px;padding-top:20px;font-size:.85rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}

@media(max-width:860px){.grid-3,.grid-2,.homes,.cli-opts{grid-template-columns:1fr}section{padding:60px 0}}
</style>
</head>
